//登録完了時のリダイレクト
function my_reg_redirect( $fields ) {
  $base_url = get_home_url();
  wp_redirect($base_url."/register-complete/");
  exit();
}
add_action( 'wpmem_register_redirect', 'my_reg_redirect' );

