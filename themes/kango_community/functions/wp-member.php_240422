// 指定ユーザIDからのユーザ有効期限チェック
function check_user_expireddate_by_user_id($userId) {

    $userExpiredDate = get_user_meta($userId, 'user_expired_date', true);
    
    if ($userExpiredDate && $userExpiredDate >= date('Y-m-d')) {
        return true;
    }

    return false;
}
